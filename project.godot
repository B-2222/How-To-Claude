; Trickshot Range - Godot 4 project settings.
; Engine configuration file.

config_version=5

[application]

config/name="Trickshot Range"
config/description="Arena trickshot shooter. Phase 1: movement and shooting feel."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]

; 120 Hz. Source-style air acceleration is evaluated per physics tick, so the
; tick rate is part of the movement feel. MovementTuning normalises for it
; (see tickrate_normalised_air_cap) but a high tick rate still gives crisper
; ground contact and less jump-height jitter.
common/physics_ticks_per_second=120
; Kept in sync with MovementTuning.gravity so RigidBody3D props and (later)
; bouncing projectiles fall at the same rate the player does.
3d/default_gravity=21.0

