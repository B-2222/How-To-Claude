# Godot 4 generated files
.godot/
/android/
# export_presets.cfg is normally ignored because it can hold signing keys and
# store credentials. This project's only preset is the Web one and it holds
# neither, so it is committed to keep the browser build reproducible.
# Re-add this line if you ever add a signed mobile or console preset.
# export_presets.cfg
*.translation

# Editor / OS noise
.DS_Store
*.swp

# Godot must not scan the exported build as project content, or each export
# gets baked into the next one. web/.gdignore stops the scan; this is a belt.
web/*.import
